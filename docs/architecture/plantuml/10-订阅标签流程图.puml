@startuml 订阅标签流程图

start

:进入订阅页面;

:加载所有标签\n和来源;

:加载用户订阅信息\n(从云数据库);

:标记已订阅项目\n(高亮显示);

:用户交互;

if (用户操作类型?) then (订阅标签)
  :点击标签芯片;
  
  :更新本地UI\n(即时反馈);
  
  :显示Toast提示\n"已关注"/"已取消";
  
  :调用云函数\nuser/subscribe/set;
  
  if (保存成功?) then (成功)
    :更新tagIds列表;
    :加载相关内容\n(基于标签);
    :显示推荐内容;
  else (失败)
    :恢复UI状态;
    :显示错误提示;
  endif
  
elseif (订阅来源) then
  :点击来源项目;
  
  :更新本地UI\n(即时反馈);
  
  :显示Toast提示;
  
  :调用云函数\nuser/subscribe/set;
  
  if (保存成功?) then (成功)
    :更新sourceIds列表;
    :刷新内容列表\n(基于来源);
  else (失败)
    :恢复UI状态;
    :显示错误提示;
  endif
  
else (批量操作)
  :点击"全选"/"清空";
  
  :更新所有标签状态;
  
  :调用云函数\n保存批量订阅;
  
  if (保存成功?) then (成功)
    :刷新内容\n(基于新订阅);
  else (失败)
    :恢复UI状态;
  endif
endif

:显示订阅统计\n(已订阅 N 个);

stop

@enduml

