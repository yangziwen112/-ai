@startuml 内容过滤活动图

start

:用户进入首页;

:从云端加载元数据\n(标签、来源、时间等);

:获取用户订阅信息;

fork
  :显示标签栏;
fork again
  :显示时间过滤;
fork again
  :显示来源过滤;
fork again
  :显示内容列表;
end fork

:用户选择过滤条件;

:构建查询条件;

if (过滤类型?) then (标签过滤)
  if (选择"全部"?) then (是)
    :显示所有内容;
  else (否)
    :筛选匹配该标签的内容;
  endif
  :更新内容列表;
  
else if (来源过滤) then
  :筛选指定来源的内容;
  :更新内容列表;
  
else if (时间过滤) then
  if (时间范围?) then (今天)
    :显示今天发布的内容;
  else if (本周)
    :显示本周发布的内容;
  else (本月)
    :显示本月发布的内容;
  endif
  :更新内容列表;
  
else (搜索)
  :调用搜索API\n(标题+描述匹配);
  :显示搜索结果;
endif

:更新标签高亮状态;

:标记已订阅项目;

:用户继续浏览/操作;

if (用户操作?) then (点击内容)
  :跳转到详情页;
  :记录浏览历史;
  
else if (点击收藏) then
  :切换收藏状态;
  
else (返回) 
  :继续浏览列表;
endif

:返回内容列表;

stop

@enduml

