/* 注册页面 */
.page-register {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  position: relative;
  overflow: hidden;
}

/* 顶部装饰 */
.header-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  pointer-events: none;
}

.circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.circle-1 {
  width: 250rpx;
  height: 250rpx;
  top: -80rpx;
  right: -30rpx;
}

.circle-2 {
  width: 180rpx;
  height: 180rpx;
  top: 120rpx;
  left: -40rpx;
}

/* 注册卡片 */
.register-card {
  width: 100%;
  max-width: 600rpx;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 32rpx;
  padding: 50rpx 40rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  z-index: 1;
  margin-top: 40rpx;
}

/* 标题 */
.register-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.header-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 表单 */
.register-form {
  width: 100%;
}

.form-item {
  margin-bottom: 28rpx;
  position: relative;
}

.input-label {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.label-icon {
  font-size: 22rpx;
  margin-right: 8rpx;
}

.label-text {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  background: #f5f7fa;
  border: 2rpx solid #e8ecf0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  transition: all 0.3s;
}

.form-input:focus {
  background: #fff;
  border-color: #667eea;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.password-toggle {
  position: absolute;
  right: 24rpx;
  bottom: 22rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.toggle-icon {
  font-size: 28rpx;
  opacity: 0.6;
}

.input-hint {
  margin-top: 8rpx;
}

.hint-text {
  font-size: 22rpx;
  color: #999;
}

.student-register-tip {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 28rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #dbeafe;
  border-radius: 18rpx;
  background: #f4f8ff;
}

.student-register-icon {
  font-size: 38rpx;
}

.student-register-title,
.student-register-desc {
  display: block;
}

.student-register-title {
  color: #1e3a8a;
  font-size: 25rpx;
  font-weight: 650;
}

.student-register-desc {
  margin-top: 5rpx;
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.45;
}

/* 注册按钮 */
.register-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 36rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.4);
  transition: all 0.3s;
}

.register-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.register-btn.disabled {
  opacity: 0.5;
  box-shadow: none;
}

/* 返回登录 */
.back-login {
  text-align: center;
  padding: 28rpx 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.back-text {
  font-size: 24rpx;
  color: #999;
}

.back-link {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 500;
}

