.settings-page {
  background: linear-gradient(135deg, #6b8cff 0%, #7c59c6 100%);
  min-height: 100vh;
  padding: 24rpx;
}

.settings-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 16rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.5);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-text {
  font-size: 28rpx;
  color: #334155;
  font-weight: 500;
}

.setting-arrow {
  font-size: 32rpx;
  color: #94a3b8;
}

.setting-item:active {
  background: rgba(107, 140, 255, 0.05);
  border-radius: 12rpx;
}