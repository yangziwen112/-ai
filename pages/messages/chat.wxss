.chat-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
}

/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #000000;
  position: sticky;
  top: 0;
  z-index: 100;
  height: 80rpx;
  box-sizing: border-box;
}

.header-left {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 12rpx;
}

.back-icon {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 600;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  flex: 1;
  text-align: center;
}

.header-right {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 12rpx;
}

/* 聊天内容 */
.chat-content {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 空状态 */
.empty-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
}

/* 消息项 */
.message-item {
  display: flex;
  align-items: flex-end;
  max-width: 70%;
  margin-bottom: 16rpx;
  gap: 12rpx;
}

.message-item.sent {
  align-self: flex-end;
  flex-direction: row-reverse;
}

.message-item.received {
  align-self: flex-start;
}

.message-bubble {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(10rpx);
  border: 1px solid rgba(255, 255, 255, 0.3);
  position: relative;
}

.message-item.sent .message-bubble {
  background: linear-gradient(135deg, #6b8cff 0%, #7c59c6 100%);
  color: #ffffff;
}

.message-text {
  font-size: 26rpx;
  line-height: 1.5;
  margin-bottom: 8rpx;
  word-break: break-word;
}

.message-time {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: right;
}

.message-item.received .message-time {
  color: rgba(0, 0, 0, 0.5);
}

/* 消息头像 */
.message-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6b8cff 0%, #7c59c6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.message-item.sent .message-avatar {
  background: linear-gradient(135deg, #60a5fa 0%, #818cf8 100%);
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-top: 1px solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8rpx);
  gap: 16rpx;
}

.emoji-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border: none;
  border-radius: 50%;
  padding: 0;
  transition: all 0.2s ease;
}

.emoji-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.emoji-icon {
  font-size: 32rpx;
}

/* 表情面板 */
.emoji-panel {
  background: rgba(255, 255, 255, 0.1);
  border-top: 1px solid rgba(255, 255, 255, 0.2);
  padding: 24rpx;
  backdrop-filter: blur(8rpx);
}

.emoji-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 24rpx;
}

.emoji-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  cursor: pointer;
  transition: all 0.2s ease;
}

.emoji-item:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.emoji {
  font-size: 40rpx;
}

.message-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #334155;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.message-input:focus {
  background: rgba(255, 255, 255, 1);
  border: 2px solid rgba(107, 140, 255, 0.5);
  box-shadow: 0 0 0 4rpx rgba(107, 140, 255, 0.1);
  transform: translateY(-2rpx);
}

.message-input::placeholder {
  color: #94a3b8;
}

.send-btn {
  background: #000000;
  color: #ffffff;
  border: none;
  border-radius: 999rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  transition: all 0.2s ease;
}

.send-btn:active:not([disabled]) {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.send-btn[disabled] {
  background: rgba(0, 0, 0, 0.5);
  box-shadow: none;
}

/* 滚动条样式 */
.chat-content::-webkit-scrollbar {
  width: 6rpx;
}

.chat-content::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 3rpx;
}

.chat-content::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.3);
  border-radius: 3rpx;
}

.chat-content::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.5);
}