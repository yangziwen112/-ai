.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #f5f7fa;
}

.chat-area {
  flex: 1;
  height: 0;
  width: 100%;
  padding: 28rpx 28rpx 36rpx;
  box-sizing: border-box;
  background: #f5f7fa;
}

/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 18rpx 28rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-bottom: 1rpx solid #e8edf5;
  position: sticky;
  top: 0;
  z-index: 100;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  color: #ffffff;
  font-size: 36rpx;
  padding: 0;
  margin-right: 20rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #172033;
  flex: 1;
}

.history-btn {
  flex: none;
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  margin: 0 10rpx 0 0;
  padding: 0;
  color: #52627a;
  background: #f5f7fb;
  border: 0;
  border-radius: 27rpx;
  font-size: 27rpx;
}

.conversation-panel {
  position: absolute;
  top: 96rpx;
  left: 20rpx;
  right: 20rpx;
  z-index: 120;
  padding: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5eaf2;
  border-radius: 18rpx;
  box-shadow: 0 12rpx 36rpx rgba(35, 53, 86, .16);
}

.conversation-panel-head { display: flex; justify-content: space-between; align-items: center; color: #1d2a3f; font-size: 26rpx; font-weight: 700; }
.conversation-close { color: #6c7b91; font-size: 22rpx; font-weight: 400; }
.conversation-list { max-height: 520rpx; margin-top: 14rpx; }
.conversation-item { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 20rpx 14rpx; border-radius: 12rpx; }
.conversation-item.active { background: #eef4ff; }
.conversation-title { flex: 1; overflow: hidden; color: #27364e; font-size: 24rpx; white-space: nowrap; text-overflow: ellipsis; }
.conversation-count { flex: none; color: #8a97a8; font-size: 20rpx; }
.conversation-empty { padding: 36rpx 0; color: #8a97a8; text-align: center; font-size: 22rpx; }

.new-chat-btn {
  flex: none;
  height: 54rpx;
  line-height: 54rpx;
  margin: 0 12rpx;
  padding: 0 18rpx;
  color: #2457d6;
  background: #eef4ff;
  border: 1rpx solid #d9e5ff;
  border-radius: 28rpx;
  font-size: 21rpx;
}

/* 状态指示器 */
.header-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-dot-container {
  position: relative;
  width: 12rpx;
  height: 12rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  position: absolute;
  top: 0;
  left: 0;
}

.status-dot.online {
  background: #4ade80;
  box-shadow: 0 0 8rpx rgba(74, 222, 128, 0.5);
}

.status-dot.offline {
  background: #fbbf24;
  box-shadow: 0 0 8rpx rgba(251, 191, 36, 0.5);
}

.status-dot-ripple {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  position: absolute;
  top: 0;
  left: 0;
  animation: ripple 1.5s ease-out infinite;
}

.status-dot-ripple.online {
  background: rgba(74, 222, 128, 0.4);
}

.status-dot-ripple.offline {
  background: rgba(251, 191, 36, 0.4);
}

@keyframes ripple {
  0% { transform: scale(1); opacity: 1; }
  100% { transform: scale(3); opacity: 0; }
}

.status-text {
  font-size: 22rpx;
  color: #718096;
}

.msg-item {
  width: 100%;
  margin-bottom: 28rpx;
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
}

.msg-item.user {
  justify-content: flex-end;
  padding-left: 112rpx;
}

.msg-item.assistant {
  justify-content: flex-start;
  align-items: flex-end;
  padding-right: 34rpx;
}

.msg-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  overflow: visible;
  margin-right: 42rpx;
  flex-shrink: 0;
  position: relative;
}

.cat-companion {
  position: absolute;
  left: 64rpx;
  top: -15rpx;
  width: 34rpx;
  height: 48rpx;
  z-index: 4;
  pointer-events: none;
  transform-origin: 50% 100%;
  animation: catFloat 2.2s ease-in-out infinite;
}

.cat-head { position: absolute; left: 3rpx; top: 3rpx; width: 28rpx; height: 25rpx; border-radius: 48% 48% 44% 44%; background: #fff4df; border: 2rpx solid #8b6b55; z-index: 3; }
.cat-ear { position: absolute; top: -7rpx; width: 11rpx; height: 13rpx; background: #fff4df; border: 2rpx solid #8b6b55; transform: rotate(45deg); z-index: -1; }
.cat-ear.left { left: 1rpx; }
.cat-ear.right { right: 1rpx; }
.cat-face { display: flex; align-items: center; justify-content: center; height: 25rpx; color: #6f5142; font-size: 13rpx; font-weight: 700; white-space: nowrap; animation: catBlink 4s infinite; }
.cat-body { position: absolute; left: 8rpx; top: 24rpx; width: 20rpx; height: 22rpx; border-radius: 45% 45% 38% 38%; background: #fff4df; border: 2rpx solid #8b6b55; z-index: 2; }
.cat-paw { position: absolute; top: 39rpx; width: 9rpx; height: 7rpx; border-radius: 50%; background: #fff4df; border: 2rpx solid #8b6b55; z-index: 4; animation: catPaw 1.4s ease-in-out infinite; }
.cat-paw.left { left: 5rpx; }
.cat-paw.right { right: 4rpx; animation-delay: .7s; }
.cat-tail { position: absolute; right: -7rpx; top: 28rpx; width: 17rpx; height: 18rpx; border: 4rpx solid #8b6b55; border-left-color: transparent; border-bottom-color: transparent; border-radius: 50%; transform-origin: left bottom; animation: catTail 1.1s ease-in-out infinite alternate; }

@keyframes catFloat { 0%,100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-5rpx) rotate(2deg); } }
@keyframes catTail { from { transform: rotate(-18deg); } to { transform: rotate(18deg); } }
@keyframes catPaw { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-4rpx); } }
@keyframes catBlink { 0%,45%,52%,100% { transform: scaleY(1); } 48%,50% { transform: scaleY(.25); } }

.msg-avatar-fallback {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
  border-radius: 50%;
  color: #fff;
  background: linear-gradient(135deg, #4f7cff, #7655c8);
  font-size: 27rpx;
  font-weight: 700;
  border: 3rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.avatar-glow {
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(107, 140, 255, 0.25), rgba(124, 89, 198, 0.25));
  animation: avatarGlow 2.5s ease-in-out infinite;
  z-index: 1;
}

@keyframes avatarGlow {
  0%, 100% { transform: scale(1); opacity: 0.3; }
  50% { transform: scale(1.1); opacity: 0.6; }
}

/* 气泡外层容器 */
.msg-bubble-wrapper {
  position: relative;
  max-width: 72%;
  min-width: 0;
  box-sizing: border-box;
}

.msg-bubble-wrapper.assistant {
  position: relative;
}

.msg-bubble-wrapper.user {
  display: flex;
  justify-content: flex-end;
  max-width: 100%;
  margin-right: 2rpx;
}

.msg-bubble {
  max-width: 100%;
  padding: 19rpx 24rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  word-wrap: break-word;
  word-break: break-all;
  overflow-wrap: anywhere;
  line-height: 1.6;
  box-shadow: 0 5rpx 16rpx rgba(31, 41, 55, 0.07);
  position: relative;
  animation: bubbleIn 0.35s ease-out;
}

@keyframes bubbleIn {
  0% { transform: translateY(10rpx) scale(0.95); opacity: 0; }
  100% { transform: translateY(0) scale(1); opacity: 1; }
}

.msg-item.user .msg-bubble {
  max-width: 100%;
  background: #2563eb;
  color: #ffffff;
  border: 1rpx solid #2563eb;
  border-bottom-right-radius: 7rpx;
  box-shadow: 0 6rpx 18rpx rgba(37, 99, 235, 0.18);
}

.msg-item.assistant .msg-bubble {
  background: #ffffff;
  color: #263244;
  border: 1rpx solid #e7ecf3;
  border-bottom-left-radius: 7rpx;
  animation: assistantBubbleIn 0.45s ease-out;
}

@keyframes assistantBubbleIn {
  0% { transform: translateX(-10rpx) translateY(10rpx) scale(0.92); opacity: 0; }
  60% { transform: translateX(2rpx) translateY(-2rpx) scale(1.02); }
  100% { transform: translateX(0) translateY(0) scale(1); opacity: 1; }
}

/* 浮动表情粒子 */
.bubble-emoji {
  position: absolute;
  font-size: 28rpx;
  animation: floatUp 2.5s ease-out forwards;
  pointer-events: none;
  opacity: 0;
}

@keyframes floatUp {
  0% { transform: translateY(0) scale(0.5) rotate(0deg); opacity: 0; }
  20% { opacity: 1; }
  80% { opacity: 0.8; }
  100% { transform: translateY(-80rpx) scale(1.2) rotate(20deg); opacity: 0; }
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 20rpx 28rpx;
  gap: 12rpx;
}

.typing-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #ffffff;
  border: 1rpx solid #e7ecf3;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #2563eb;
  animation: typingBounce 1.4s ease-in-out infinite;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typingBounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-12rpx); opacity: 1; }
}

.typing-text {
  font-size: 22rpx;
  color: #718096;
}

.workflow-stage { font-size: 21rpx; color: #2563eb; animation: stagePulse 1.2s ease-in-out infinite; }
.workflow-badge { display: inline-flex; margin-bottom: 8rpx; padding: 3rpx 10rpx; color: #1d4ed8; background: #eff6ff; border-radius: 999rpx; font-size: 18rpx; font-weight: 650; }
@keyframes stagePulse { 0%,100% { opacity: .55; } 50% { opacity: 1; } }

.input-area {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #ffffff;
  border-top: 1rpx solid #e7ecf3;
  gap: 14rpx;
  box-shadow: 0 -4rpx 18rpx rgba(31, 41, 55, 0.04);
}

.image-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin: 0;
  padding: 0;
  background: #f1f5f9;
  border: none;
  border-radius: 50%;
}

.image-btn::after {
  border: 0;
}

.image-icon {
  color: #2563eb;
  font-size: 36rpx;
  line-height: 1;
}

.attachment-strip {
  display: flex;
  gap: 14rpx;
  padding: 12rpx 24rpx 16rpx;
  overflow-x: auto;
  background: #ffffff;
  border-top: 1rpx solid #eef2f7;
}

.attachment-item {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
}

.attachment-image,
.message-image {
  background: #eef2f7;
  border-radius: 12rpx;
}

.attachment-image {
  width: 112rpx;
  height: 112rpx;
}

.attachment-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  background: #475569;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1;
}

.message-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.message-image {
  width: 220rpx;
  height: 220rpx;
}

.emoji-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #f1f5f9;
  border: none;
  border-radius: 50%;
  padding: 0;
  transition: all 0.2s ease;
}

.emoji-btn:active {
  background: #e2e8f0;
  transform: scale(0.95);
}

.emoji-icon {
  font-size: 32rpx;
}

.input {
  flex: 1;
  min-width: 0;
  height: 70rpx;
  background: #f5f7fa;
  border: 1rpx solid #e2e8f0;
  border-radius: 999rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #1f2937;
  transition: all 0.3s ease;
}

.input:focus {
  background: #ffffff;
  border-color: #93b4f5;
  box-shadow: 0 0 0 4rpx rgba(37, 99, 235, 0.08);
}

.input::placeholder {
  color: #94a3b8;
}

.send-btn {
  flex-shrink: 0;
  min-width: 108rpx;
  height: 68rpx;
  margin: 0;
  padding: 0 24rpx;
  line-height: 68rpx;
  background: #2563eb;
  color: #ffffff;
  border: none;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 5rpx 14rpx rgba(37, 99, 235, 0.22);
  transition: all 0.2s ease;
}

.send-btn:active:not([disabled]) {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(37, 99, 235, 0.22);
}

.send-btn[disabled] {
  color: #ffffff;
  background: #9db7ec;
  box-shadow: none;
}

/* 表情面板 */
.emoji-panel {
  background: #ffffff;
  border-top: 1rpx solid #e7ecf3;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.emoji-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 24rpx;
}

.emoji-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  cursor: pointer;
  transition: all 0.2s ease;
}

.emoji-item:active {
  background: #e9eef5;
  transform: scale(0.95);
}

.emoji {
  font-size: 40rpx;
}

/* 消息文本 */
.msg-text {
  font-size: 27rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

/* 高亮可点击文本 */
.msg-highlight {
  color: #2563eb;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

/* 链接卡片区域 */
.msg-links {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
}

.links-title {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.link-card {
  display: flex;
  align-items: center;
  padding: 16rpx;
  margin-bottom: 10rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  transition: all 0.2s ease;
}

.link-card:active {
  background: #eff6ff;
  transform: scale(0.98);
}

.link-card.web {
  background: #f0fdf4;
  border-color: #dcfce7;
}

.link-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.link-info {
  flex: 1;
  overflow: hidden;
}

.link-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.link-desc {
  font-size: 22rpx;
  color: #999;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.link-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 8rpx;
  flex-shrink: 0;
}
