.info-card { display: flex; margin-bottom: 18rpx; overflow: hidden; background: #fff; border: 1rpx solid #e7edf5; border-radius: 18rpx; box-shadow: 0 6rpx 18rpx rgba(33, 56, 92, .055); }
.info-card:active { background: #fbfcfe; transform: scale(.995); }
.cover-wrap { width: 190rpx; min-height: 230rpx; flex-shrink: 0; background: #eaf0f8; }
.cover { width: 100%; height: 100%; min-height: 230rpx; display: block; }
.card-main { flex: 1; min-width: 0; padding: 22rpx; }
.meta-row { display: flex; align-items: center; min-width: 0; margin-bottom: 12rpx; color: #8996a8; font-size: 20rpx; }
.category { flex-shrink: 0; margin-right: 10rpx; padding: 4rpx 10rpx; color: #1d4ed8; background: #eaf2ff; border-radius: 999rpx; font-size: 19rpx; font-weight: 600; }
.category-competition { color: #6d28d9; background: #f0eaff; }
.category-recruit { color: #b45309; background: #fff2d8; }
.category-academic { color: #0369a1; background: #e0f2fe; }
.category-certification, .category-teacher-cert { color: #047857; background: #dcfce7; }
.category-sports { color: #c2410c; background: #ffedd5; }
.category-notice { color: #1d4ed8; background: #eaf2ff; }
.source { max-width: 180rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dot { margin: 0 7rpx; }
.time { flex-shrink: 0; }
.title { display: -webkit-box; overflow: hidden; color: #172033; font-size: 29rpx; line-height: 1.42; font-weight: 680; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.summary { display: -webkit-box; overflow: hidden; margin-top: 11rpx; color: #64748b; font-size: 23rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.card-bottom { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 18rpx; gap: 14rpx; }
.tags { flex: 1; min-width: 0; display: flex; gap: 10rpx; overflow: hidden; white-space: nowrap; }
.tag { color: #78879b; font-size: 20rpx; }
.favorite { display: flex; align-items: center; flex-shrink: 0; gap: 5rpx; color: #7b8798; font-size: 21rpx; }
.favorite.active { color: #d97706; }
.favorite-icon { font-size: 28rpx; line-height: 1; }
@media (max-width: 375px) {
  .cover-wrap { width: 168rpx; }
  .card-main { padding: 18rpx; }
  .title { font-size: 27rpx; }
}
